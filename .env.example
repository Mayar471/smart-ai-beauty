# Copy this file to runtime/.env and fill in the values. The runtime/ folder is never committed.
# Every key is optional: without them the app still runs, with AI features shown as unavailable.

# Text recommendations and the beauty advisor chat
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Image generation (Cloudflare Workers AI, FLUX.2 klein 4B)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Optional local text provider instead of Gemini
# AI_PROVIDER=ollama
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=

# PORT=3000
